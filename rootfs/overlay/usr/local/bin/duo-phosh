#!/bin/sh
# session Phosh (dans le chroot) : bus système, logind, upower, NetworkManager, puis phoc + phosh + squeekboard
export HOME=/root XDG_RUNTIME_DIR=/run/user/0
mkdir -p $XDG_RUNTIME_DIR /run/dbus; chmod 700 $XDG_RUNTIME_DIR
udevd --daemon 2>/dev/null; udevadm trigger; udevadm settle -t 5
mountpoint -q /sys/fs/cgroup || mount -t tmpfs cgroup /sys/fs/cgroup 2>/dev/null
mkdir -p /sys/fs/cgroup/elogind; mountpoint -q /sys/fs/cgroup/elogind || mount -t cgroup -o none,name=elogind cgroup /sys/fs/cgroup/elogind 2>/dev/null
rm -f /run/dbus/*
dbus-daemon --system --fork 2>/dev/null
/usr/libexec/elogind --daemon 2>/dev/null
(/usr/libexec/upowerd >/dev/null 2>&1 &)
(/usr/libexec/accounts-daemon >/dev/null 2>&1 &)
(/usr/libexec/apk-polkit/apk-polkit-server > /tmp/apk-polkit.log 2>&1 &)   # logithèque : paquets Alpine (dev.Cogitri.apkPolkit2)
(NetworkManager --no-daemon > /tmp/nm.log 2>&1 &)
gsettings set org.gnome.desktop.screensaver lock-enabled false 2>/dev/null
# dalles au niveau du noyau (méthode Matrix « duo-panels beide ») : couper le connecteur fantôme Virtual-1
# (il prend des ressources d'affichage et fige DSI-2), forcer DSI-1 et DSI-2 allumés
echo off > /sys/class/drm/card0-Virtual-1/status 2>/dev/null
echo on > /sys/class/drm/card0-DSI-1/status 2>/dev/null
echo on > /sys/class/drm/card0-DSI-2/status 2>/dev/null
udevadm trigger --action=change /sys/class/drm/card0 2>/dev/null
# réactivité : plancher GPU 345 MHz au lieu de 257 (le gouverneur msm-adreno-tz monte trop tard pour les débuts
# d'animation / de défilement) et bus mémoire non dissocié du GPU
echo 345000000 > /sys/class/kgsl/kgsl-3d0/devfreq/min_freq 2>/dev/null
echo 0 > /sys/class/kgsl/kgsl-3d0/bus_split 2>/dev/null
# luminosité : Phosh ne règle que la dalle principale -> recopie sur la 2e (duo-blmirror de Matrix)
pidof duo-blmirror >/dev/null || (/usr/local/bin/duo-blmirror > /tmp/blmirror.log 2>&1 &)
# fenêtres déplaçables d'un écran à l'autre (3 doigts) une fois la session prête
(sleep 20; /usr/local/bin/duo-ecrans > /tmp/ecrans.log 2>&1) &
# phoc patché : chaque écran tactile sur sa dalle (les deux dalles ont la même identité EDID)
export PHOC_TOUCH_MAP="Surface Duo Touch A=DSI-1;Surface Duo Touch B=DSI-2"
export WLR_RENDERER=pixman LIBSEAT_BACKEND=noop GSK_RENDERER=cairo GDK_DISABLE=gl
# GPU (méthode Matrix) : OpenGL via Zink -> Vulkan Turnip sur KGSL. Désactivable : rm /etc/duo/gpu.env
[ -f /etc/duo/gpu.env ] && . /etc/duo/gpu.env
export XDG_CURRENT_DESKTOP=Phosh:GNOME XDG_SESSION_DESKTOP=phosh XDG_SESSION_TYPE=wayland
# applis Flatpak (Logiciels / Flathub) visibles dans la grille de Phosh ; Electron en Wayland natif (pas de Xwayland)
export XDG_DATA_DIRS=/root/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share
export ELECTRON_OZONE_PLATFORM_HINT=auto
# Flatpak : la session est chrootée, Linux y refuse les espaces de noms utilisateur -> bwrap sans --unshare-user
export FLATPAK_BWRAP=/usr/local/bin/duo-bwrap
# session D-Bus : réglages GNOME, son (PipeWire), touche Power, puis phoc + phosh + clavier
# relancée automatiquement si elle s'arrête (plantage de phoc/phosh) : sinon écran noir définitif.
# Le journal de la session plantée est gardé dans /tmp/phosh-plantage-HHMMSS.log
while true; do
	mkdir -p $XDG_RUNTIME_DIR; chmod 700 $XDG_RUNTIME_DIR
	dbus-run-session -- /usr/local/bin/duo-dans-session > /tmp/phosh.log 2>&1
	cp /tmp/phosh.log /tmp/phosh-plantage-$(date +%H%M%S).log
	killall phosh squeekboard phoc waybar pipewire wireplumber pipewire-pulse duo-power callaudiod gnome-calls chatty gsd-wwan gsd-rfkill 2>/dev/null
	rm -f /run/duo/clavier-ecran
	sleep 3
done
